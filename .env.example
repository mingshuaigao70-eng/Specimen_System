# ==========================================
# 电子标本馆系统 — 环境变量配置
# 复制此文件为 .env 并填写实际值
# ==========================================

# Flask 安全密钥（必填，使用 python -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=change-me-to-a-random-secret-key

# Flask 调试模式（生产环境务必设为 false）
FLASK_DEBUG=false

# MySQL 数据库配置（必填）
DB_USER=specimen_app
DB_PASSWORD=your-database-password
DB_HOST=localhost
DB_NAME=specimen_db

# 默认超级管理员初始密码（首次部署时使用，之后请通过管理后台修改）
ADMIN_DEFAULT_PASSWORD=change-me-on-first-login
